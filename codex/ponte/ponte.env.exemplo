# Configuração da ponte. Copie este arquivo para "ponte.env" (sem o ".exemplo")
# e preencha. Abra com o Bloco de Notas.
#
# ⚠️ O token é a "chave" do bot. Cole você mesmo, aqui no computador, na SUA
# conta (não na conta Agente). Nunca mande o token por mensagem, e-mail ou print.

# O token que o @BotFather te deu (algo como 1234567890:AAH...).
TELEGRAM_BOT_TOKEN=

# A pasta do agente (onde está o AGENTS.md). A ponte fica em C:\PonteAgente,
# fora dela.
PASTA_AGENTE=C:\Users\Agente\agente

# O nome do agente (aparece na mensagem de pareamento).
NOME_AGENTE=

# Opcionais (pode deixar como está):
# Reação que aparece na mensagem dela assim que a ponte recebe.
REACAO=👀
# Texto usado só se o Telegram não aceitar a reação.
AVISO=recebi, já estou pensando... 💭
# Busca na internet (sim ou nao).
BUSCA_WEB=sim
# Tempo máximo para uma resposta, em minutos.
LIMITE_MINUTOS=15

# Onde está o Codex (o arquivo codex.js). Vazio = a ponte procura sozinha: no
# Node que roda a ponte (Homebrew, nvm, instalador oficial), nos lugares comuns
# do npm e no comando "codex" do PATH. Se ela disser "não achei o Codex", rode
#   realpath "$(command -v codex)"      (Mac/Linux)
# e cole aqui o caminho que terminar em bin/codex.js. Exemplo no Mac com Homebrew:
# CODEX_JS=/opt/homebrew/lib/node_modules/@openai/codex/bin/codex.js
CODEX_JS=

# Áudio (opcional): a chave da Groq (console.groq.com → API Keys), começa com gsk_.
# Com ela, as mensagens de voz viram texto. O áudio vai para os servidores da Groq.
# ⚠️ A ponte só liga com a chave se confirmar que o Codex NÃO consegue ler este
# arquivo. O Codex roda com a mesma conta da ponte: no Mac a cerca dele não
# bloqueia leitura, então lá deixe vazio (sem áudio). Veja o item S3 do
# "Socorro da ponte" no codex/LEIA-ME.md.
GROQ_API_KEY=
