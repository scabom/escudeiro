<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Escudeiro: LaunchAgent "vigia-atrasos". Modelo com marcadores; o instalar-launchd.sh preenche:
    {{ROTULO}}        prefixo do rótulo, ex.: com.escudeiro.aurora
    {{PASTA_AGENTE}}  caminho completo da pasta do agente
    {{HOME}}          a pasta do usuário
    (sem horário: roda a cada 30 minutos)
  Roda embrulhado pelo rotina-vigiada.sh: falha vira aviso no Telegram, e o vigia-atrasos.py
  percebe quando ele nem rodou (Mac dormindo, desligado).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ROTULO}}.vigia-atrasos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{PASTA_AGENTE}}/ferramentas/rotina-vigiada.sh</string>
    <string>vigia-atrasos</string>
    <string>--avisar</string>
    <string>1</string>
    <string>--</string>
    <string>/usr/bin/python3</string>
    <string>{{PASTA_AGENTE}}/ferramentas/vigia-atrasos.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{PASTA_AGENTE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key>
    <string>pt_BR.UTF-8</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{PASTA_AGENTE}}/logs/launchd-vigia-atrasos.log</string>
  <key>StandardErrorPath</key>
  <string>{{PASTA_AGENTE}}/logs/launchd-vigia-atrasos.log</string>
</dict>
</plist>
