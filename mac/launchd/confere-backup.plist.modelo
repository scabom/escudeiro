<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Escudeiro: LaunchAgent "confere-backup". Modelo com marcadores; o instalar-launchd.sh preenche:
    {{ROTULO}}        prefixo do rótulo, ex.: com.escudeiro.aurora
    {{PASTA_AGENTE}}  caminho completo da pasta do agente
    {{HOME}}          a pasta do usuário
    {{HORA_CONFERE}} / {{MINUTO_CONFERE}}  horário (padrão 22h40, uns 40 min depois do backup)
  Roda embrulhado pelo rotina-vigiada.sh: falha vira aviso no Telegram, e o vigia-atrasos.py
  percebe quando ele nem rodou (Mac dormindo, desligado).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ROTULO}}.confere-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{PASTA_AGENTE}}/ferramentas/rotina-vigiada.sh</string>
    <string>confere-backup</string>
    <string>--avisar</string>
    <string>1</string>
    <string>--</string>
    <string>/bin/bash</string>
    <string>{{PASTA_AGENTE}}/ferramentas/confere-backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{PASTA_AGENTE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key>
    <string>pt_BR.UTF-8</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>{{HORA_CONFERE}}</integer>
    <key>Minute</key>
    <integer>{{MINUTO_CONFERE}}</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>{{PASTA_AGENTE}}/logs/launchd-confere-backup.log</string>
  <key>StandardErrorPath</key>
  <string>{{PASTA_AGENTE}}/logs/launchd-confere-backup.log</string>
</dict>
</plist>
